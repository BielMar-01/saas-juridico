{
  "name": "saas-juridico",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": "24.x",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "dev:web": "pnpm --filter @saas-juridico/web dev",
    "dev:api": "pnpm --filter @saas-juridico/api dev",
    "start": "turbo start",
    "start:web": "pnpm --filter @saas-juridico/web start",
    "start:api": "pnpm --filter @saas-juridico/api start"
  },
  "devDependencies": {
    "turbo": "2.11.4"
  }
}
