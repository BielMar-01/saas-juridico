{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "NODE_ENV", "PORT", "HOST", "LOG_LEVEL", "WEB_ORIGIN", "DATABASE_URL",
        "SUPABASE_URL", "SUPABASE_PUBLISHABLE_KEY", "SUPABASE_JWKS_URL",
        "INVITATION_TOKEN_SECRET", "INVITATION_TTL_HOURS", "INVITATION_RESEND_COOLDOWN_SECONDS"
      ]
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "NODE_ENV", "PORT", "HOST", "LOG_LEVEL", "WEB_ORIGIN", "DATABASE_URL",
        "SUPABASE_URL", "SUPABASE_PUBLISHABLE_KEY", "SUPABASE_JWKS_URL",
        "INVITATION_TOKEN_SECRET", "INVITATION_TTL_HOURS", "INVITATION_RESEND_COOLDOWN_SECONDS"
      ]
    }
  }
}
