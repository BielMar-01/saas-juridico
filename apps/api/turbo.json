{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "NODE_ENV", "PORT", "HOST", "LOG_LEVEL", "WEB_ORIGIN", "DATABASE_URL", "DIRECT_URL",
        "SUPABASE_URL", "SUPABASE_PUBLISHABLE_KEY", "SUPABASE_SECRET_KEY", "SUPABASE_JWKS_URL"
      ]
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "NODE_ENV", "PORT", "HOST", "LOG_LEVEL", "WEB_ORIGIN", "DATABASE_URL", "DIRECT_URL",
        "SUPABASE_URL", "SUPABASE_PUBLISHABLE_KEY", "SUPABASE_SECRET_KEY", "SUPABASE_JWKS_URL"
      ]
    }
  }
}
