NODE_ENV=development
PORT=3333
HOST=0.0.0.0
LOG_LEVEL=info
WEB_ORIGIN=http://localhost:3000

DATABASE_URL="postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@POOLER_HOST:6543/postgres?pgbouncer=true"
 # ADMIN ONLY: Prisma migrations and controlled scripts; never pass to HTTP runtime.
DIRECT_URL="postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@POOLER_HOST:5432/postgres"

SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY="[YOUR-PUBLISHABLE-KEY]"
# ADMIN ONLY: bootstrap script; never pass to HTTP runtime.
SUPABASE_SECRET_KEY="[YOUR-NEW-SECRET-KEY]"
SUPABASE_JWKS_URL="https://PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json"

# Somente para o script administrativo de bootstrap; não usados pelo servidor
BOOTSTRAP_MODE="verify"
BOOTSTRAP_AUTH_USER_ID="[AUTH-USER-UUID]"
BOOTSTRAP_EMAIL="[OWNER-EMAIL]"
BOOTSTRAP_NAME="[OWNER-NAME]"
BOOTSTRAP_ORGANIZATION_NAME="[ORGANIZATION-NAME]"
BOOTSTRAP_ORGANIZATION_SLUG="[ORGANIZATION-SLUG]"

INVITATION_TOKEN_SECRET=
INVITATION_TTL_HOURS=72
INVITATION_RESEND_COOLDOWN_SECONDS=60
